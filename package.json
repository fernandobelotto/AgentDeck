{
  "name": "agentdeck",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "Stream Deck plugin to monitor and control AI agent instances",
  "main": "com.agentdeck.plugin.sdPlugin/bin/plugin.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "link": "streamdeck link com.agentdeck.plugin.sdPlugin",
    "restart": "streamdeck restart com.agentdeck.plugin",
    "preview": "open preview.html",
    "icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "streamdeck",
    "claude",
    "claude-code",
    "gemini",
    "ai-agents",
    "plugin"
  ],
  "author": "AgentDeck",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^1.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "rollup": "^4.29.2",
    "sharp": "^0.34.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
